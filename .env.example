# MySQL 8 connection (Aiven / TiDB Cloud / PlanetScale-compatible / own VPS)
DATABASE_URL=mysql://user:password@host:3306/potatofirst
# set to "true" for cloud MySQL that requires TLS
DATABASE_SSL=false
# 32+ random characters — signs admin session cookies
ADMIN_SESSION_SECRET=
# first Super Admin created by `npm run db:seed`
ADMIN_EMAIL=admin@potatofirst.com
ADMIN_PASSWORD=
NEXT_PUBLIC_SITE_URL=https://potatofirst.vercel.app
