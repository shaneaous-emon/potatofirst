# ── Required on the live server (cPanel → Setup Node.js App → Environment variables) ──

# MySQL 8 connection. Without it, login / sign-up / admin are disabled.
DATABASE_URL=mysql://user:password@localhost:3306/potatofirst
# set to "true" for cloud MySQL that requires TLS
DATABASE_SSL=false

# 32+ random characters each. REQUIRED in production (no built-in fallback).
ADMIN_SESSION_SECRET=
CUSTOMER_SESSION_SECRET=

# Public URL of the site (used for Google/Facebook redirect URIs)
SITE_URL=https://potatofirst.premiumexportshoes.com
NEXT_PUBLIC_SITE_URL=https://potatofirst.premiumexportshoes.com

# first Super Admin created by `npm run db:seed`
ADMIN_EMAIL=admin@potatofirst.com
ADMIN_PASSWORD=

# ── Optional: real social login. Buttons appear only when these are set. ──
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
#   Authorized redirect URI: {SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Meta for Developers → App → Facebook Login → Valid OAuth Redirect URIs:
#   {SITE_URL}/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
